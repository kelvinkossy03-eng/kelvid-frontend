# Kelvid backend — copy to .env and fill in
HF_TOKEN=hf_your_token_here
HF_PROVIDER=fal-ai
HF_MODEL=Wan-AI/Wan2.2-TI2V-5B
# --- production knobs ---
MAX_CONCURRENT_JOBS=2
MAX_QUEUE=20
RATE_LIMIT_PER_MIN=20
CORS_ORIGINS=*
# Optional: require clients to send header X-API-Key: <value>
KELVID_API_KEY=
PORT=8000
